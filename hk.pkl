amends "package://github.com/jdx/hk/releases/download/v1.2.0/hk@1.2.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.2.0/hk@1.2.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["rustfmt"] {
        glob = "*.rs"
        check = "cargo fmt --all -- --check"
        fix   = "cargo fmt --all"
    }
    ["clippy"] {
        glob  = "*.rs"
        check = "cargo clippy --release --locked --all-targets -- -D warnings"
    }
    ["pkl"] {
        glob  = "*.pkl"
        check = "pkl eval {{files}} >/dev/null"
    }
}

hooks {
    ["pre-commit"] {
        fix   = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps {
            ...linters
            ["test"] {
                check     = "cargo test --release --locked"
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix   = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
